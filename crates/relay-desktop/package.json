{
  "name": "relay-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "oxfmt --write src index.html vite.config.ts",
    "format:check": "oxfmt --check src index.html vite.config.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "gen:bindings": "cargo run --manifest-path ../../Cargo.toml -p relay-desktop --bin export_bindings -- src/bindings.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@streamdown/cjk": "^1.0.5",
    "@tanstack/react-query": "^5.108.2",
    "@tauri-apps/api": "^2.12.5",
    "@xyflow/react": "^13.0.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "i18next": "^27.2.2",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.3",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "streamdown": "^2.8.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "reactDoctor": {
    "ignore": {
      "files": ["src/bindings.ts", "src/components/ui/**"]
    }
  }
}
